From a0d6550bbe4a309b63f96654b3f818e30106d4fa Mon Sep 17 00:00:00 2001
From: GrecAndrei <alex092lap@duck.com>
Date: Thu, 16 Jul 2026 12:20:00 +0300
Subject: [PATCH 1/6] mmc: sunxi: Add Allwinner A733 v5p3 MMC support

Add an A733 configuration based on the D1 SMHC feature set. A733's v5p3
controller requires its module clock to run at twice the card clock in new
timing mode, including for SDR SDIO transfers. Also program the v5p3 CMD
drive phase (180°) and clear NTSR sample phases like the vendor v5p3 host,
and skip forcing SAMP_DL_SW_EN so the reset state matches the BSP path used
for AIC8800 SDIO enumeration.
---
 drivers/mmc/host/sunxi-mmc.c | 55 ++++++++++++++++++++++++++++++++++++
 1 file changed, 55 insertions(+)

diff --git a/drivers/mmc/host/sunxi-mmc.c b/drivers/mmc/host/sunxi-mmc.c
index 8dbcff53a..000000000 100644
--- a/drivers/mmc/host/sunxi-mmc.c
+++ b/drivers/mmc/host/sunxi-mmc.c
@@ -221,6 +221,12 @@
 
 #define SDXC_2X_TIMING_MODE	BIT(31)
 
+/* A733 / SMHC v5p3 drive and new-timing sample phase bits */
+#define SDXC_DAT_DRV_PH_SEL		BIT(17)
+#define SDXC_CMD_DRV_PH_SEL		BIT(16)
+#define SDXC_STIMING_CMD_PH_MASK	GENMASK(5, 4)
+#define SDXC_STIMING_DAT_PH_MASK	GENMASK(9, 8)
+
 #define SDXC_CAL_START		BIT(15)
 #define SDXC_CAL_DONE		BIT(14)
 #define SDXC_CAL_DL_SHIFT	8
@@ -265,6 +271,9 @@ struct sunxi_mmc_cfg {
 	/* clock hardware can switch between old and new timing modes */
 	bool ccu_has_timings_switch;
 
+	/* module clock runs at twice the card clock in new timing mode */
+	bool needs_2x_clk;
+
 };
 
@@ -786,6 +795,9 @@ static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 	 * We currently only support the standard MMC DDR52 mode.
 	 * This block should be updated once support for other DDR
 	 * modes is added.
 	 */
+	if (host->cfg->needs_2x_clk)
+		clock <<= 1;
+
 	if (ios->timing == MMC_TIMING_MMC_DDR52 &&
 	    (host->use_new_timings ||
 	     ios->bus_width == MMC_BUS_WIDTH_8)) {
@@ -827,6 +839,8 @@ static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 	/* update card clock rate to account for internal divider */
 	rate /= div;
+	if (host->cfg->needs_2x_clk)
+		rate /= 2;
 
 	/*
 	 * Configure the controller to use the new timing mode if needed.
@@ -844,12 +858,36 @@ static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 		mmc_writel(host, REG_SD_NTSR, rval);
 	}
 
+	/*
+	 * A733 SMHC v5p3: program drive delay and NTSR sample phases like
+	 * vendor sunxi-mmc-v5p3x 400 kHz / HS defaults (CMD 180°, DAT 90°,
+	 * sample phases 0).
+	 */
+	if (host->cfg->needs_2x_clk) {
+		rval = mmc_readl(host, REG_DRV_DL);
+		rval |= SDXC_CMD_DRV_PH_SEL;
+		rval &= ~SDXC_DAT_DRV_PH_SEL;
+		mmc_writel(host, REG_DRV_DL, rval);
+
+		rval = mmc_readl(host, REG_SD_NTSR);
+		rval &= ~(SDXC_STIMING_CMD_PH_MASK | SDXC_STIMING_DAT_PH_MASK);
+		mmc_writel(host, REG_SD_NTSR, rval);
+	}
+
 	/* sunxi_mmc_clk_set_phase expects the actual card clock rate */
 	ret = sunxi_mmc_clk_set_phase(host, ios, rate);
 	if (ret)
 		return ret;
 
-	ret = sunxi_mmc_calibrate(host, SDXC_REG_SAMP_DL_REG);
-	if (ret)
-		return ret;
+	/* Vendor v5p3 leaves SAMP_DL alone; skip forcing SAMP_DL_SW_EN. */
+	if (!host->cfg->needs_2x_clk) {
+		ret = sunxi_mmc_calibrate(host, SDXC_REG_SAMP_DL_REG);
+		if (ret)
+			return ret;
+	}
 
 	/*
 	 * FIXME:
@@ -1171,6 +1209,15 @@
+static const struct sunxi_mmc_cfg sun60i_a733_cfg = {
+	.idma_des_size_bits = 13,
+	.idma_des_shift = 2,
+	.can_calibrate = true,
+	.mask_data0 = true,
+	.needs_new_timings = true,
+	.needs_2x_clk = true,
+};
+
 static const struct sunxi_mmc_cfg sun20i_d1_cfg = {
@@ -1216,6 +1263,7 @@ static const struct of_device_id sunxi_mmc_of_match[] = {
 	{ .compatible = "allwinner,sun50i-a64-emmc", .data = &sun50i_a64_emmc_cfg },
 	{ .compatible = "allwinner,sun50i-a100-mmc", .data = &sun20i_d1_cfg },
 	{ .compatible = "allwinner,sun50i-a100-emmc", .data = &sun50i_a100_emmc_cfg },
 	{ .compatible = "allwinner,sun50i-h616-mmc", .data = &sun50i_h616_cfg },
+	{ .compatible = "allwinner,sun60i-a733-mmc", .data = &sun60i_a733_cfg },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, sunxi_mmc_of_match);
-- 
