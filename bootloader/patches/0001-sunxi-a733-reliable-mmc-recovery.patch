From d759ac0bc2a1bad0676b93ec3a7ae61593592249 Mon Sep 17 00:00:00 2001
From: Grec Andrei Alexander <alexander.grec@scoala197.ro>
Date: Wed, 15 Jul 2026 21:18:29 +0300
Subject: [PATCH] sunxi: make A733 MMC boot recovery reliable

---
 Makefile                              |  2 +-
 cmd/mmc.c                             |  4 +--
 configs/sun60iw2p1_t736_defconfig     | 16 ++++++++-
 drivers/block/blk_legacy.c            | 22 +++++-------
 drivers/mmc/host/sunxi_mmc_host_tm4.c | 29 +++++++++++----
 drivers/mmc/mmc.c                     |  2 +-
 drivers/mmc/mmc_legacy.c              |  8 +++--
 drivers/mmc/sunxi_mmc.c               | 52 +++++++++++++++++++--------
 env/Kconfig                           |  4 +--
 9 files changed, 96 insertions(+), 43 deletions(-)

diff --git a/Makefile b/Makefile
index 9d4f86a..dab118f 100755
--- a/Makefile
+++ b/Makefile
@@ -308,7 +308,7 @@ endif
 endif
 
 ifeq (x$(CONFIG_ARM), xy)
-CROSS_COMPILE := $(srctree)/../tools/toolchain/gcc-linaro-7.2.1-2017.11-x86_64_arm-linux-gnueabi/bin/arm-linux-gnueabi-
+CROSS_COMPILE ?= $(srctree)/../tools/toolchain/gcc-linaro-7.2.1-2017.11-x86_64_arm-linux-gnueabi/bin/arm-linux-gnueabi-
 DTS_PATH := $(PWD)/arch/arm/dts
 endif
 
diff --git a/cmd/mmc.c b/cmd/mmc.c
index d9406d7..09cab2b 100644
--- a/cmd/mmc.c
+++ b/cmd/mmc.c
@@ -950,7 +950,8 @@ static int do_mmcops(cmd_tbl_t *cmdtp, int flag, int argc, char * const argv[])
 
 	if (curr_device < 0) {
 		if (get_mmc_num() >= 0) {
-			curr_device = 0;
+			/* Legacy sunxi registers the physical host number. */
+			curr_device = get_mmc_num();
 		} else {
 			puts("No MMC device available\n");
 			return CMD_RET_FAILURE;
@@ -1051,4 +1052,3 @@ U_BOOT_CMD(
 	"sunxi_card0_probe"
 );
 
-
diff --git a/configs/sun60iw2p1_t736_defconfig b/configs/sun60iw2p1_t736_defconfig
index 71aefc3..e5fdee8 100644
--- a/configs/sun60iw2p1_t736_defconfig
+++ b/configs/sun60iw2p1_t736_defconfig
@@ -1,3 +1,6 @@
+CONFIG_LOCALVERSION="-a733-reliable"
+# CONFIG_LOCALVERSION_AUTO is not set
+CONFIG_IDENT_STRING=" Orange Pi 4 Pro reliable"
 CONFIG_SUNXI_TEXT_SIZE=0x150000
 CONFIG_RESERVE_FDT_SIZE=0x80000
 CONFIG_ARM=y
@@ -30,6 +33,14 @@ CONFIG_SUNXI_RKP=y
 CONFIG_CMD_FASTBOOT=y
 CONFIG_CMD_PART=y
 CONFIG_CMD_USB=y
+CONFIG_CMD_GPIO=y
+CONFIG_CMD_HASH=y
+CONFIG_HASH_VERIFY=y
+CONFIG_CMD_TIME=y
+CONFIG_CMD_GETTIME=y
+CONFIG_CMD_TIMER=y
+CONFIG_CMD_CACHE=y
+# CONFIG_CMD_SAVEENV is not set
 CONFIG_CMD_SUNXI_TIMER=y
 CONFIG_CMD_SUNXI_SPRITE=y
 CONFIG_CMD_SUNXI_BURN=y
@@ -115,10 +126,13 @@ CONFIG_CMD_PXE=y
 
 CONFIG_DISTRO_DEFAULTS=y
 CONFIG_ENV_VARS_UBOOT_CONFIG=y
+CONFIG_BOOTDELAY=3
+CONFIG_ENV_SIZE=0x20000
 
 CONFIG_EXT4_WRITE=y
 CONFIG_CMD_EXT4_WRITE=y
-CONFIG_ENV_IS_IN_EXT4=y
+CONFIG_ENV_IS_NOWHERE=y
+# CONFIG_ENV_IS_IN_EXT4 is not set
 #CONFIG_ENV_IS_IN_SUNXI_FLASH=y
 
 #CONFIG_CMD_SF=y
diff --git a/drivers/block/blk_legacy.c b/drivers/block/blk_legacy.c
index 72f06ef..1fd872c 100644
--- a/drivers/block/blk_legacy.c
+++ b/drivers/block/blk_legacy.c
@@ -241,21 +241,17 @@ struct blk_desc *blk_get_devnum_by_typename(const char *if_typename, int devnum)
 	if (0 == strcmp(if_typename, "nvme"))
 		return aw_blk_get_devnum_by_typename(if_typename, devnum);
 #endif
+	struct blk_driver *drv = blk_driver_lookup_typename(if_typename);
+	struct blk_desc *desc;
 
-	static struct blk_desc *desc;
-	static char cache_if_typename[16] = {0};
-	if ((desc == NULL) || (cache_if_typename[0] == 0) ||
-		(strncmp(if_typename, cache_if_typename, max(strlen(if_typename), strlen(cache_if_typename))))) {
-		memset(cache_if_typename, 0, (strlen(cache_if_typename) + 1));
-		strncpy(cache_if_typename, if_typename, strlen(if_typename));
-		struct blk_driver *drv = blk_driver_lookup_typename(if_typename);
-
-		if (!drv)
-			return NULL;
+	/*
+	 * Device identity includes the device number.  Caching only by
+	 * interface name made every later "mmc N" request reuse whichever
+	 * MMC descriptor happened to be looked up first.
+	 */
+	if (!drv || get_desc(drv, devnum, &desc))
+		return NULL;
 
-		if (get_desc(drv, devnum, &desc))
-			return NULL;
-	}
 	return desc;
 }
 
diff --git a/drivers/mmc/host/sunxi_mmc_host_tm4.c b/drivers/mmc/host/sunxi_mmc_host_tm4.c
index 5600172..8a7260e 100644
--- a/drivers/mmc/host/sunxi_mmc_host_tm4.c
+++ b/drivers/mmc/host/sunxi_mmc_host_tm4.c
@@ -438,6 +438,23 @@ static void sunxi_mmc_set_speed_mode(struct sunxi_mmc_priv *priv,
 }
 
 extern int mmc_update_clk(struct sunxi_mmc_priv *priv);
+
+static int mmc_wait_calibration_done(struct sunxi_mmc_priv *mmchost,
+				     volatile u32 *reg, const char *name)
+{
+	unsigned long start = get_timer(0);
+
+	while (!(readl(reg) & SDXC_CalDone)) {
+		if (get_timer(start) > 1000) {
+			MMCINFO("mmc %d timeout calibrating %s delay\n",
+				mmchost->mmc_no, name);
+			return -ETIMEDOUT;
+		}
+	}
+
+	return 0;
+}
+
 static int mmc_calibrate_delay_unit(struct sunxi_mmc_priv *mmchost)
 {
  #ifndef FPGA_PLATFORM
@@ -481,9 +498,9 @@ static int mmc_calibrate_delay_unit(struct sunxi_mmc_priv *mmchost)
 		rval = SDXC_StartCal;
 		writel(rval, &reg->samp_dl);
 		writel(0x0, &reg->samp_dl);
-		while (!(readl(&reg->samp_dl) & SDXC_CalDone)) {
-			;
-		}
+		if (mmc_wait_calibration_done(mmchost, &reg->samp_dl,
+					      "sample"))
+			return -ETIMEDOUT;
 
 		if (mmchost->mmc_no == 2) {
 			writel(0xA0, &reg->ds_dl);
@@ -491,9 +508,9 @@ static int mmc_calibrate_delay_unit(struct sunxi_mmc_priv *mmchost)
 			rval = SDXC_StartCal;
 			writel(rval, &reg->ds_dl);
 			writel(0x0, &reg->ds_dl);
-			while (!(readl(&reg->ds_dl) & SDXC_CalDone)) {
-				;
-			}
+			if (mmc_wait_calibration_done(mmchost, &reg->ds_dl,
+						      "data strobe"))
+				return -ETIMEDOUT;
 		}
 
 		/* update result */
diff --git a/drivers/mmc/mmc.c b/drivers/mmc/mmc.c
index 39e5f1e..82dbc4f 100644
--- a/drivers/mmc/mmc.c
+++ b/drivers/mmc/mmc.c
@@ -2942,7 +2942,7 @@ static int mmc_startup(struct mmc *mmc)
 	bdesc->revision[0] = 0;
 #endif
 #if !defined(CONFIG_SPL_BUILD) || defined(CONFIG_SPL_LIBDISK_SUPPORT)
-//	part_init(bdesc);
+	part_init(bdesc);
 #endif
 
 	return 0;
diff --git a/drivers/mmc/mmc_legacy.c b/drivers/mmc/mmc_legacy.c
index a14f0d3..a06a625 100644
--- a/drivers/mmc/mmc_legacy.c
+++ b/drivers/mmc/mmc_legacy.c
@@ -117,16 +117,18 @@ void print_mmc_devices(char separator)
 		else
 			mmc_type = NULL;
 
-		MMCDBG("%s: %d", m->cfg->name, m->block_dev.devnum);
+		printf("%s: %d", m->cfg->name, m->block_dev.devnum);
 		if (mmc_type)
-			MMCINFO(" (%s)", mmc_type);
+			printf(" (%s)", mmc_type);
 
 		if (entry->next != &mmc_devices) {
-			MMCINFO("%c", separator);
+			printf("%c", separator);
 			if (separator != '\n')
 				puts(" ");
 		}
 	}
+	if (!list_empty(&mmc_devices))
+		putc('\n');
 }
 
 #else
diff --git a/drivers/mmc/sunxi_mmc.c b/drivers/mmc/sunxi_mmc.c
index 16bf61e..1feacce 100644
--- a/drivers/mmc/sunxi_mmc.c
+++ b/drivers/mmc/sunxi_mmc.c
@@ -30,6 +30,7 @@
 #endif
 
 #define DTO_MAX 200
+#define SUNXI_MMC_HW_TIMEOUT_MS 1000
 
 #if !CONFIG_IS_ENABLED(DM_MMC)
 /* support 4 mmc hosts */
@@ -209,10 +210,27 @@ int mmc_clk_io_onoff(int sdc_no, int onoff, int reset_clk)
 	return 0;
 }
 
+static int sunxi_mmc_wait_reg_clear(struct sunxi_mmc_priv *priv,
+				    volatile uint *reg, uint mask,
+				    const char *operation)
+{
+	unsigned long start = get_timer(0);
+
+	while (readl(reg) & mask) {
+		if (get_timer(start) > SUNXI_MMC_HW_TIMEOUT_MS) {
+			MMCINFO("mmc %d timeout waiting for %s (reg=%08x)\n",
+				priv->mmc_no, operation, readl(reg));
+			return -ETIMEDOUT;
+		}
+	}
+
+	return 0;
+}
+
 int mmc_update_clk(struct sunxi_mmc_priv *priv)
 {
 	unsigned int cmd;
-	unsigned timeout_msecs = 10000;
+	unsigned timeout_msecs = SUNXI_MMC_HW_TIMEOUT_MS;
 	unsigned long start = get_timer(0);
 
 	writel(readl(&priv->reg->clkcr)|(0x1 << 31), &priv->reg->clkcr);
@@ -223,9 +241,13 @@ int mmc_update_clk(struct sunxi_mmc_priv *priv)
 	writel(cmd, &priv->reg->cmd);
 	while (readl(&priv->reg->cmd) & SUNXI_MMC_CMD_START) {
 		if (get_timer(start) > timeout_msecs) {
-				dumphex32("mmc", (char *)priv->reg, 0x200);
-				return -1;
-			}
+			MMCINFO("mmc %d clock update timeout: cmd=%08x "
+				"gctrl=%08x rint=%08x status=%08x\n",
+				priv->mmc_no, readl(&priv->reg->cmd),
+				readl(&priv->reg->gctrl), readl(&priv->reg->rint),
+				readl(&priv->reg->status));
+			return -ETIMEDOUT;
+		}
 	}
 	writel(readl(&priv->reg->clkcr) & (~(0x1 << 31)), &priv->reg->clkcr);
 
@@ -496,8 +518,9 @@ static int mmc_trans_data_by_dma(struct sunxi_mmc_priv *priv, struct mmc *mmc, s
 	rval = readl(&priv->reg->gctrl);
 	writel(rval | (1 << 5) | (1 << 2), &priv->reg->gctrl);	/* dma enable */
 	writel((1 << 0), &priv->reg->dmac); /* idma reset */
-	while (readl(&priv->reg->dmac) & 0x1) {
-	} /* wait idma reset done */
+	if (sunxi_mmc_wait_reg_clear(priv, &priv->reg->dmac, 0x1,
+				     "IDMA reset"))
+		return -ETIMEDOUT;
 
 	writel((1 << 1) | (1 << 7), &priv->reg->dmac); /* idma on */
 	rval = readl(&priv->reg->idie) & (~3);
@@ -894,7 +917,8 @@ static int sunxi_mmc_do_send_cmd_common(struct sunxi_mmc_priv *priv,
 			usedma = 1;
 			writel(readl(&priv->reg->gctrl) & (~SUNXI_MMC_GCTRL_ACCESS_BY_AHB), &priv->reg->gctrl);
 			ret = mmc_trans_data_by_dma(priv, mmc, data);
-			writel(cmdval | cmd->cmdidx, &priv->reg->cmd);
+			if (!ret)
+				writel(cmdval | cmd->cmdidx, &priv->reg->cmd);
 		} else {
 			writel(readl(&priv->reg->gctrl) | SUNXI_MMC_GCTRL_ACCESS_BY_AHB, &priv->reg->gctrl);
 			writel(cmdval | cmd->cmdidx, &priv->reg->cmd);
@@ -1012,9 +1036,8 @@ out:
 
 		mmc_save_regs(priv);
 		writel(0x7, &priv->reg->gctrl);
-		while (readl(&priv->reg->gctrl)&0x7) {
-			MMCDBG("mmc reset dma fifo and fifo\n");
-		};
+		sunxi_mmc_wait_reg_clear(priv, &priv->reg->gctrl, 0x7,
+					 "controller reset");
 
 		{
 			mmc_clk_io_onoff(priv->mmc_no, 0, 0);
@@ -1022,14 +1045,15 @@ out:
 			mmc_clk_io_onoff(priv->mmc_no, 1, 0);
 
 			writel(0x7, &priv->reg->gctrl);
-			while (readl(&priv->reg->gctrl)&0x7) {
-				MMCDBG("mmc reset dma fifo and fifo\n");
-			};
+			if (sunxi_mmc_wait_reg_clear(priv, &priv->reg->gctrl, 0x7,
+						     "controller reset retry"))
+				priv->fatal_err = 1;
 		}
 
 		writel(SUNXI_MMC_GCTRL_RESET, &priv->reg->gctrl);
 		mmc_restore_regs(priv);
-		mmc_update_clk(priv);
+		if (mmc_update_clk(priv))
+			priv->fatal_err = 1;
 	}
 	writel(0xffffffff, &priv->reg->rint);
 	writel(readl(&priv->reg->gctrl) | SUNXI_MMC_GCTRL_FIFO_RESET,
diff --git a/env/Kconfig b/env/Kconfig
index 79972c5..c22dd00 100644
--- a/env/Kconfig
+++ b/env/Kconfig
@@ -470,10 +470,10 @@ config ENV_OFFSET
 
 config ENV_SIZE
 	hex "Environment Size"
