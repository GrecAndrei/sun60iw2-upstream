 	default 0x20000 if ARCH_SUNXI
 	help
-	  Size of the environment storage area
+	  Size of the in-memory environment. Persistent environment backends
+	  also use this as their storage size.
 
 config SYS_MAXARGS
 	hex "Environment Max number of command args"
