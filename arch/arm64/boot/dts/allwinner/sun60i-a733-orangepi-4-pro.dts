/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "sun60i-a733.dtsi"

/ {
	model = "Orange Pi 4 Pro";
	compatible = "xunlong,orangepi-4-pro", "allwinner,sun60i-a733";

	aliases {
		serial0 = &uart0;
		ethernet0 = &gmac0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/*
	 * Orange Pi 4 Pro has 8GB LPDDR4.
	 * DRAM starts at 0x40000000 (1GB offset).
	 * U-Boot typically modifies this, but we hardcode
	 * to avoid panics when U-Boot's memory node is wrong.
	 */
	memory@40000000 {
		device_type = "memory";
		reg = <0x00000000 0x40000000 0x00000002 0x00000000>;
	};

	reg_vcc3v3_sd: regulator-vcc3v3-sd {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3-sd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	reg_vcc3v3_eth: regulator-vcc3v3-eth {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3-eth";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	reg_usb_host_vbus: regulator-usb-host-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb-host-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	/*
	 * VCC-WIFI and VCCIO-WIFI are board rails that are already up when
	 * the kernel starts and are not switched per-card. They are modelled
	 * as fixed regulators on purpose: the MMC core power-cycles whatever
	 * it is handed as vmmc/vqmmc (sunxi_mmc_card_power() calls
	 * regulator_disable() on MMC_POWER_OFF), so an AXP8191 rail must
	 * never be wired here. On this board those rails come off shared PMIC
	 * outputs that also feed non-Wi-Fi consumers, and cutting them powers
	 * the board off.
	 */
	reg_vcc3v3_wifi: regulator-vcc3v3-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3-wifi";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	reg_vcc1v8_wifi_io: regulator-vcc1v8-wifi-io {
		compatible = "regulator-fixed";
		regulator-name = "vccio-wifi";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		/* WL_REG_ON is an active-high enable, hence active-low reset. */
		reset-gpios = <&r_pio 1 1 GPIO_ACTIVE_LOW>; /* PM1 */
		post-power-on-delay-ms = <200>;
	};
};

&pio {
	/* PG carries the Wi-Fi SDIO bus and is supplied by BLDO5 at 1.8 V. */
	vcc-pg-supply = <&reg_bldo5>;
	vcc-pf-supply = <&reg_vcc3v3_sd>;

	uart1_pins: uart1-pins {
		pins = "PK20", "PK21", "PK22", "PK23";
		allwinner,pinmux = <8>;
		function = "uart1";
		drive-strength = <10>;
		bias-pull-up;
	};
};

&r_pio {
	/* PM0/PM1 are WL_HOST_WAKE/WL_REG_ON and are supplied by CLDO1. */
	vcc-pm-supply = <&reg_cldo1>;
	/*
	 * vcc-pl-supply is deliberately not described: PL carries the I2C bus
	 * to the AXP8191 that would provide it, so naming it here would be a
	 * circular dependency.
	 */

	s_twi0_pins_default: s-twi0-default-pins {
		pins = "PL0", "PL1";
		function = "s_twi0";
		allwinner,pinmux = <2>;
		drive-strength = <10>;
		bias-pull-up;
	};

	s_twi0_pins_sleep: s-twi0-sleep-pins {
		pins = "PL0", "PL1";
		function = "io_disabled";
		allwinner,pinmux = <7>;
		drive-strength = <10>;
	};
};

&uart0 {
	status = "okay";
};

&mmc0 {
	status = "okay";
	pinctrl-0 = <&mmc0_pins &mmc0_clk_pin>;
	pinctrl-names = "default";
	cd-gpios = <&pio 5 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PF6 */
	cd-debounce-delay-ms = <200>;
	bus-width = <4>;
	cap-sd-highspeed;
	no-1-8-v;
	no-sdio;
	no-mmc;
	vmmc-supply = <&reg_vcc3v3_sd>;
	vqmmc-supply = <&reg_vcc3v3_sd>;
};

&s_twi0 {
	status = "okay";
	pinctrl-0 = <&s_twi0_pins_default>;
	pinctrl-1 = <&s_twi0_pins_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <400000>;

	pmu0: pmu@36 {
		compatible = "x-powers,axp8191";
		reg = <0x36>;

		/*
		 * Only the rails this port actually needs are described.
		 * A rail declared without regulator-always-on is disabled by
		 * regulator_init_complete() once its use count reaches zero
		 * (regulator-boot-on does not prevent this), so every rail
		 * listed here is either always-on or has a permanent consumer.
		 * Undeclared rails keep the state the bootloader left them in.
		 */
		regulators {
			/*
			 * Shared 3.3 V system rail: PCIe 3v3 and the input of
			 * the DC1SW1/DC1SW2 switches. Declared always-on so it
			 * can never be switched off by a consumer; the range
			 * matches the vendor description so no voltage is
			 * written at probe.
			 */
			reg_dcdc1: dcdc1 {
				regulator-name = "axp8191-dcdc1";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <3800000>;
				regulator-ramp-delay = <250>;
				regulator-enable-ramp-delay = <1000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/*
			 * PG pad supply for the Wi-Fi SDIO bus, 1.8 V. The
			 * vendor holds this rail on for the lifetime of the
			 * Wi-Fi device; A733 pinctrl selects pad voltages
			 * automatically (SUNXI_PINCTRL_AUTO_POWER_SWITCH) and
			 * so never claims vcc-pg-supply, leaving no consumer
			 * to hold it up. always-on is that guarantee.
			 */
			reg_bldo5: bldo5 {
				regulator-name = "axp8191-bldo5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-enable-ramp-delay = <1000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* PM pad supply for WL_REG_ON / WL_HOST_WAKE, 1.8 V. */
			reg_cldo1: cldo1 {
				regulator-name = "axp8191-cldo1";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-enable-ramp-delay = <1000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};
};

&mmc1 {
	status = "okay";
	pinctrl-0 = <&mmc1_pins &mmc1_clk_pin>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	ignore-pm-notify;
	execute_tuning_in_kernel;
	sunxi-dly-208M = <0xff 0x1 0xff 0xff 0xff 0xff>;
	ctl-spec-caps = <0x428>;
	mmc-pwrseq = <&wifi_pwrseq>;
	non-removable;
	max-frequency = <50000000>;
	no-sd;
	no-mmc;
	/*
	 * Board Wi-Fi rails, not PMIC outputs. vmmc supplies the OCR mask
	 * (3.3 V module VBAT) and vqmmc selects 1.8 V SDIO signalling to
	 * match the 1.8 V PG pads. Both are fixed and always-on so the MMC
	 * power-cycle path cannot drop a rail the rest of the board shares.
	 */
	vmmc-supply = <&reg_vcc3v3_wifi>;
	vqmmc-supply = <&reg_vcc1v8_wifi_io>;

	wifi@1 {
		reg = <1>;
		compatible = "aicsemi,aic8800d80", "aicsemi,aic8800";
	};
};

&mmc2 {
	status = "disabled";
	pinctrl-0 = <&mmc2_pins>;
	pinctrl-names = "default";
	bus-width = <8>;
	non-removable;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	no-sdio;
	no-sd;
};

&uart1 {
	status = "okay";
	pinctrl-0 = <&uart1_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;

	bluetooth {
		compatible = "aicsemi,aic8800d80-bt", "aicsemi,aic8800-bt";
		max-speed = <1500000>;
	};
};

/* Ethernet abandoned for now — gmac0 probe hangs boot
 * See docs/status.md and .tmp/ethernet-plan.md
&gmac0 {
	status = "okay";
};

&gmac0_phy0 {
	phy-supply = <&reg_vcc3v3_eth>;
};
 */

&usbphy {
	usb1_vbus-supply = <&reg_usb_host_vbus>;
	status = "okay";
};

&ehci0 {
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};
