/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "sun60i-a733.dtsi"

/ {
	model = "Orange Pi 4 Pro";
	compatible = "xunlong,orangepi-4-pro", "allwinner,sun60i-a733";

	aliases {
		serial0 = &uart0;
		ethernet0 = &gmac0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/*
	 * Orange Pi 4 Pro has 8GB LPDDR4.
	 * DRAM starts at 0x40000000 (1GB offset).
	 * U-Boot typically modifies this, but we hardcode
	 * to avoid panics when U-Boot's memory node is wrong.
	 */
	memory@40000000 {
		device_type = "memory";
		reg = <0x00000000 0x40000000 0x00000002 0x00000000>;
	};

	reg_vcc3v3_sd: regulator-vcc3v3-sd {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3-sd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	reg_vcc3v3_eth: regulator-vcc3v3-eth {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3-eth";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	reg_usb_host_vbus: regulator-usb-host-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb-host-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		/* WL_REG_ON is an active-high enable, hence active-low reset. */
		reset-gpios = <&r_pio 1 1 GPIO_ACTIVE_LOW>; /* PM1 */
		post-power-on-delay-ms = <200>;
	};
};

&pio {
	/* PG carries the Wi-Fi SDIO bus and is supplied by BLDO5 at 1.8 V. */
	vcc-pg-supply = <&reg_bldo5>;
	vcc-pf-supply = <&reg_vcc3v3_sd>;

	uart1_pins: uart1-pins {
		pins = "PK20", "PK21", "PK22", "PK23";
		allwinner,pinmux = <8>;
		function = "uart1";
		drive-strength = <10>;
		bias-pull-up;
	};
};

&r_pio {
	/* PM0/PM1 are WL_HOST_WAKE/WL_REG_ON and are supplied by CLDO1. */
	vcc-pm-supply = <&reg_cldo1>;
	vcc-pl-supply = <&reg_vcc3v3_sd>;

	s_twi0_pins_default: s-twi0-default-pins {
		pins = "PL0", "PL1";
		function = "s_twi0";
		allwinner,pinmux = <2>;
		drive-strength = <10>;
		bias-pull-up;
	};

	s_twi0_pins_sleep: s-twi0-sleep-pins {
		pins = "PL0", "PL1";
		function = "io_disabled";
		allwinner,pinmux = <7>;
		drive-strength = <10>;
	};
};

&uart0 {
	status = "okay";
};

&mmc0 {
	status = "okay";
	pinctrl-0 = <&mmc0_pins &mmc0_clk_pin>;
	pinctrl-names = "default";
	cd-gpios = <&pio 5 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PF6 */
	cd-debounce-delay-ms = <200>;
	bus-width = <4>;
	cap-sd-highspeed;
	no-1-8-v;
	no-sdio;
	no-mmc;
	vmmc-supply = <&reg_vcc3v3_sd>;
	vqmmc-supply = <&reg_vcc3v3_sd>;
};

&s_twi0 {
	status = "okay";
	pinctrl-0 = <&s_twi0_pins_default>;
	pinctrl-1 = <&s_twi0_pins_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <400000>;

	pmu0: pmu@36 {
		compatible = "x-powers,axp8191";
		reg = <0x36>;

		regulators {
			/* U4 VBAT: VCC-WIFI / VCC-3V3-WIFI (schematic sheet 21). */
			reg_dcdc1: dcdc1 {
				regulator-name = "vcc-wifi";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-init-microvolt = <3300000>;
			};

			/* U4 VDDIO: VCCIO-WIFI (schematic sheets 4 and 21). */
			reg_bldo2: bldo2 {
				regulator-name = "vccio-wifi";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-init-microvolt = <1800000>;
				regulator-enable-ramp-delay = <1000>;
			};

			reg_bldo5: bldo5 {
				regulator-name = "axp8191-bldo5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-init-microvolt = <1800000>;
				regulator-enable-ramp-delay = <1000>;
				regulator-boot-on;
			};

			reg_cldo1: cldo1 {
				regulator-name = "axp8191-cldo1";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-init-microvolt = <1800000>;
				regulator-enable-ramp-delay = <1000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};
};

&mmc1 {
	status = "okay";
	pinctrl-0 = <&mmc1_pins &mmc1_clk_pin>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	ignore-pm-notify;
	execute_tuning_in_kernel;
	sunxi-dly-208M = <0xff 0x1 0xff 0xff 0xff 0xff>;
	ctl-spec-caps = <0x428>;
	mmc-pwrseq = <&wifi_pwrseq>;
	non-removable;
	max-frequency = <50000000>;
	no-sd;
	no-mmc;
	/* AP6611 VBAT is 3.3 V DCDC1; its SDIO VDDIO is 1.8 V BLDO2. */
	vmmc-supply = <&reg_dcdc1>;
	vqmmc-supply = <&reg_bldo2>;

	wifi@1 {
		reg = <1>;
		compatible = "aicsemi,aic8800d80", "aicsemi,aic8800";
	};
};

&mmc2 {
	status = "disabled";
	pinctrl-0 = <&mmc2_pins>;
	pinctrl-names = "default";
	bus-width = <8>;
	non-removable;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	no-sdio;
	no-sd;
};

&uart1 {
	status = "okay";
	pinctrl-0 = <&uart1_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;

	bluetooth {
		compatible = "aicsemi,aic8800d80-bt", "aicsemi,aic8800-bt";
		max-speed = <1500000>;
	};
};

/* Ethernet abandoned for now — gmac0 probe hangs boot
 * See docs/status.md and .tmp/ethernet-plan.md
&gmac0 {
	status = "okay";
};

&gmac0_phy0 {
	phy-supply = <&reg_vcc3v3_eth>;
};
 */

&usbphy {
	usb1_vbus-supply = <&reg_usb_host_vbus>;
	status = "okay";
};

&ehci0 {
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};
