From a0d6550bbe4a309b63f96654b3f818e30106d4fa Mon Sep 17 00:00:00 2001
From: GrecAndrei <alex092lap@duck.com>
Date: Thu, 16 Jul 2026 12:20:00 +0300
Subject: [PATCH 1/6] mmc: sunxi: Add Allwinner A733 v5p3 MMC support

Add an A733 configuration based on the D1 SMHC feature set. A733's v5p3
controller requires its module clock to run at twice the card clock in new
timing mode, including for SDR SDIO transfers. Keep the D1 behavior unchanged
and account for the hardware 2x timing stage when reporting the card rate.
---
 drivers/mmc/host/sunxi-mmc.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/drivers/mmc/host/sunxi-mmc.c b/drivers/mmc/host/sunxi-mmc.c
index 8dbcff53a..000000000 100644
--- a/drivers/mmc/host/sunxi-mmc.c
+++ b/drivers/mmc/host/sunxi-mmc.c
@@ -265,3 +265,6 @@ struct sunxi_mmc_cfg {
 	/* clock hardware can switch between old and new timing modes */
 	bool ccu_has_timings_switch;
+
+	/* module clock runs at twice the card clock in new timing mode */
+	bool needs_2x_clk;
 };
@@ -786,5 +789,8 @@ static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
+	if (host->cfg->needs_2x_clk)
+		clock <<= 1;
+
 	if (ios->timing == MMC_TIMING_MMC_DDR52 &&
 	    (host->use_new_timings ||
 	     ios->bus_width == MMC_BUS_WIDTH_8)) {
 		div = 2;
 		clock <<= 1;
@@ -827,3 +833,5 @@ static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 	rate /= div;
+	if (host->cfg->needs_2x_clk)
+		rate /= 2;
 
 	/*
@@ -1171,1 +1171,10 @@
+static const struct sunxi_mmc_cfg sun60i_a733_cfg = {
+	.idma_des_size_bits = 13,
+	.idma_des_shift = 2,
+	.can_calibrate = true,
+	.mask_data0 = true,
+	.needs_new_timings = true,
+	.needs_2x_clk = true,
+};
+
 static const struct sunxi_mmc_cfg sun20i_d1_cfg = {
@@ -1216,6 +1234,7 @@ static const struct of_device_id sunxi_mmc_of_match[] = {
 	{ .compatible = "allwinner,sun50i-a64-emmc", .data = &sun50i_a64_emmc_cfg },
 	{ .compatible = "allwinner,sun50i-a100-mmc", .data = &sun20i_d1_cfg },
 	{ .compatible = "allwinner,sun50i-a100-emmc", .data = &sun50i_a100_emmc_cfg },
 	{ .compatible = "allwinner,sun50i-h616-mmc", .data = &sun50i_h616_cfg },
+	{ .compatible = "allwinner,sun60i-a733-mmc", .data = &sun60i_a733_cfg },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, sunxi_mmc_of_match);
