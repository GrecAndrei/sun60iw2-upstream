/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "sun60i-a733.dtsi"
#include "sun60i-a733-cpu-opp.dtsi"

/ {
	model = "Orange Pi 4 Pro";
	compatible = "xunlong,orangepi-4-pro", "allwinner,sun60i-a733";

	aliases {
		serial0 = &uart0;
		ethernet0 = &gmac0;
		mmc0 = &mmc0;
		mmc1 = &mmc1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/*
	 * Orange Pi 4 Pro has 8GB LPDDR4.
	 * DRAM starts at 0x40000000 (1GB offset).
	 * U-Boot typically modifies this, but we hardcode
	 * to avoid panics when U-Boot's memory node is wrong.
	 */
	memory@40000000 {
		device_type = "memory";
		reg = <0x00000000 0x40000000 0x00000002 0x00000000>;
	};

	reg_vcc3v3_sd: regulator-vcc3v3-sd {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3-sd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	reg_vcc3v3_eth: regulator-vcc3v3-eth {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3-eth";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	reg_usb_host_vbus: regulator-usb-host-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb-host-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	/*
	 * Vendor: enable BLDO5/CLDO1 -> 10 ms -> assert WL_REG_ON (PM1 high) ->
	 * 50 ms -> sunxi_mmc_rescan. Mainline equivalent is mmc-pwrseq-simple:
	 * WL_REG_ON is an active-high enable, so model it as ACTIVE_LOW reset
	 * (deassert drives PM1 high). The rails are shared with Bluetooth and
	 * remain enabled, so the post-power-on delay is the vendor's exact 50 ms
	 * REG_ON-to-rescan interval. Power-off waits 100 ms before redetection.
	 */
	wifi_pwrseq: pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&r_pio 1 1 GPIO_ACTIVE_LOW>; /* PM1 WL_REG_ON */
		post-power-on-delay-ms = <50>;
		power-off-delay-us = <100000>;
	};
};

&pio {
	/*
	 * PF (SD card) stays on the fixed 3.3 V board rail. PG (Wi-Fi SDIO)
	 * uses AXP BLDO5 @ 1.8 V. With SUNXI_PINCTRL_AUTO_POWER_SWITCH the
	 * pinctrl driver never claims vcc-pg or writes PIO_POW_MOD (vendor
	 * auto_hard); BLDO5 must stay always-on to keep the rail up, and
	 * POW_MOD @ 0x340 is left to the bootloader/hardware auto path.
	 * Do not put BLDO5 on the whole PIO block without a PF override —
	 * that deferred the controller when AXP was missing.
	 */
	vcc-pf-supply = <&reg_vcc3v3_sd>;
	vcc-pg-supply = <&reg_bldo5>;

	uart1_pins: uart1-pins {
		pins = "PK20", "PK21", "PK22", "PK23";
		allwinner,pinmux = <8>;
		function = "uart1";
		drive-strength = <10>;
		bias-pull-up;
	};
};

&r_pio {
	/*
	 * Same rule as vcc-pg: do not defer r_pio on AXP CLDO1 or s_twi0/PMU
	 * can never come up (and console/wifi pwrseq stay stuck).
	 */
	/*
	 * vcc-pl-supply is deliberately not described: PL carries the I2C bus
	 * to the AXP8191 that would provide it, so naming it here would be a
	 * circular dependency.
	 */

	s_twi0_pins_default: s-twi0-default-pins {
		pins = "PL0", "PL1";
		function = "s_twi0";
		allwinner,pinmux = <2>;
		drive-strength = <10>;
		bias-pull-up;
	};

	s_twi0_pins_sleep: s-twi0-sleep-pins {
		pins = "PL0", "PL1";
		function = "io_disabled";
		allwinner,pinmux = <7>;
		drive-strength = <10>;
	};
};

&uart0 {
	status = "okay";
	/*
	 * Console UART: drop DMA. printk/earlycon use PIO and keep working;
	 * the tty write path uses 8250 DMA and was hanging forever here, so
	 * PID1 appeared dead after "Run /sbin/init" with no userspace output.
	 */
	/delete-property/ dmas;
	/delete-property/ dma-names;
};

&mmc0 {
	status = "okay";
	pinctrl-0 = <&mmc0_pins &mmc0_clk_pin>;
	pinctrl-names = "default";
	/*
	 * CD on PF6 has been unreliable in recent boots (kernel waits forever
	 * for root while the host reader sees the card fine). Poll instead.
	 */
	broken-cd;
	bus-width = <4>;
	cap-sd-highspeed;
	no-1-8-v;
	no-sdio;
	no-mmc;
	vmmc-supply = <&reg_vcc3v3_sd>;
	vqmmc-supply = <&reg_vcc3v3_sd>;
};

&s_twi0 {
	status = "okay";
	pinctrl-0 = <&s_twi0_pins_default>;
	pinctrl-1 = <&s_twi0_pins_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <400000>;

	pmu0: pmu@36 {
		compatible = "x-powers,axp8191";
		reg = <0x36>;

		/*
		 * Only the rails this port actually needs are described.
		 * A rail declared without regulator-always-on is disabled by
		 * regulator_init_complete() once its use count reaches zero
		 * (regulator-boot-on does not prevent this), so every rail
		 * listed here is either always-on or has a permanent consumer.
		 * Undeclared rails keep the state the bootloader left them in.
		 */
		regulators {
			/*
			 * Do not declare dcdc1 here. Modern regulator OF sets
			 * apply_uV whenever min/max are present; a failed
			 * get_voltage (-ENXIO) then aborts the entire AXP
			 * regulator probe and BLDO5/CLDO1 never appear.
			 * Undeclared rails keep the bootloader voltage.
			 */

			/* Big-cluster CPU rail (A76). */
			reg_dcdc3: dcdc3 {
				regulator-name = "axp8191-dcdc3";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1540000>;
				regulator-ramp-delay = <250>;
				regulator-enable-ramp-delay = <1000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* Little-cluster CPU rail (A55). */
			reg_dcdc5: dcdc5 {
				regulator-name = "axp8191-dcdc5";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1540000>;
				regulator-ramp-delay = <250>;
				regulator-enable-ramp-delay = <1000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/*
			 * PG pad supply for Wi-Fi SDIO @ 1.8 V. Vendor
			 * sunxi_wlan_set_power() forces 1800 mV then enables;
			 * keep always-on + fixed 1.8 V so pad auto_hard and
			 * the chip see a stable rail without rfkill.
			 */
			reg_bldo5: bldo5 {
				regulator-name = "axp8191-bldo5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* PM pad supply for WL_REG_ON / WL_HOST_WAKE, 1.8 V. */
			reg_cldo1: cldo1 {
				regulator-name = "axp8191-cldo1";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};
};

&cpu0 {
	cpu-supply = <&reg_dcdc5>;
};

&cpu1 {
	cpu-supply = <&reg_dcdc5>;
};

&cpu2 {
	cpu-supply = <&reg_dcdc5>;
};

&cpu3 {
	cpu-supply = <&reg_dcdc5>;
};

&cpu4 {
	cpu-supply = <&reg_dcdc5>;
};

&cpu5 {
	cpu-supply = <&reg_dcdc5>;
};

&cpu6 {
	cpu-supply = <&reg_dcdc3>;
};

&cpu7 {
	cpu-supply = <&reg_dcdc3>;
};

/*
 * Wi-Fi SDIO on SMHC1. Vendor leaves the host in software-detect mode and
 * only rescans after aicbsp powers the chip; mainline runs that power+settle
 * sequence via wifi_pwrseq before the first CMD5. No vmmc/vqmmc (vendor
 * leaves them unwired; rails are always-on above). Stay at high-speed only
 * until CMD5 works; vendor UHS caps come later. No wifi@ child until the
 * SDIO card enumerates.
 */
&mmc1 {
	status = "okay";
	pinctrl-0 = <&mmc1_pins &mmc1_clk_pin>;
	pinctrl-names = "default";
	bus-width = <4>;
	non-removable;
	mmc-pwrseq = <&wifi_pwrseq>;
	no-mmc;
	no-sd;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	max-frequency = <50000000>;
};

&mmc2 {
	status = "disabled";
	pinctrl-0 = <&mmc2_pins>;
	pinctrl-names = "default";
	bus-width = <8>;
	non-removable;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	no-sdio;
	no-sd;
};

&uart1 {
	status = "okay";
	pinctrl-0 = <&uart1_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;

	bluetooth {
		compatible = "aicsemi,aic8800d80-bt", "aicsemi,aic8800-bt";
		max-speed = <1500000>;
	};
};

/* Ethernet abandoned for now — gmac0 probe hangs boot
 * See docs/status.md and .tmp/ethernet-plan.md
&gmac0 {
	status = "okay";
};

&gmac0_phy0 {
	phy-supply = <&reg_vcc3v3_eth>;
};
 */

&usbphy {
	usb1_vbus-supply = <&reg_usb_host_vbus>;
	status = "okay";
};

&ehci0 {
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};
